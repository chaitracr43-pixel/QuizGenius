# ==============================================================================
# QuizGenius - Environment Variables Configuration Template
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Database Configuration
# Default uses local SQLite; replace with PostgreSQL URI in production:
# postgresql://username:password@localhost:5432/quizgenius_db
DATABASE_URL=sqlite:///database/quizgenius.db

# AI API Integration (Google Gemini API / OpenAI API)
# Leave empty to run in automatic curated Demonstration Mode (no API key needed)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_optional_alternate_ai_key_here

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:3000
